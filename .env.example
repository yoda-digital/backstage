# DevPane Developer Portal — Production Environment Variables
# Copy this to .env and fill in your values

# === REQUIRED ===

# PostgreSQL (used by Backstage for all plugin data)
POSTGRES_USER=backstage
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password
POSTGRES_DB=backstage

# Cloudflare Tunnel (get from Cloudflare Zero Trust dashboard)
CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token_here

# Public URLs (must match your Cloudflare Tunnel domain)
PORTAL_BASE_URL=https://ai.esemplagov.tech
BACKEND_BASE_URL=https://ai.esemplagov.tech

# === GITLAB INTEGRATION ===

# GitLab Personal Access Token (api scope)
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# GitLab OAuth Application (for user login)
# Create at: https://your-gitlab/-/admin/applications
AUTH_GITLAB_CLIENT_ID=
AUTH_GITLAB_CLIENT_SECRET=

# === AZURE DEVOPS ===

# Azure DevOps Personal Access Token
AZURE_TOKEN=

# === KUBERNETES ===

K8S_CLUSTER_NAME=
K8S_CLUSTER_URL=
K8S_SERVICE_ACCOUNT_TOKEN=
