    "type": "git",
    "url": "https://github.com/backstage/backstage",
    "directory": "plugins/soundcheck-backend"
  },
  "license": "Apache-2.0",
  "sideEffects": false,
  "main": "src/index.ts",
  "types": "src/index.ts",
